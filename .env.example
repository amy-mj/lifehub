# LifeHub 환경 변수
# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#   vi .env
#
# ⚠️ .env 는 절대 git 에 커밋하지 마세요.

# ── 필수 ─────────────────────────────────────────────────────
# 토큰 서명 키. 반드시 교체하세요.
#   openssl rand -hex 32
JWT_SECRET=여기에_랜덤_문자열_입력

# ── 포트 ─────────────────────────────────────────────────────
# ⚠️ 이 서버는 80/443 을 cafe24 의 common-nginx 가 이미 쓰고 있습니다.
#    반드시 3000 이상을 지정하세요. 80 을 넣으면 바인딩 실패합니다.
HOST_PORT=3000

# ── 소유권 (매우 중요) ────────────────────────────────────────
# 호스트에서 `id -u` / `id -g` 를 실행해 나온 숫자를 넣으세요.
# 컨테이너 앱은 이 uid 로 돌아야 ./data 에 SQLite 파일을 만들 수 있습니다.
# 비워두면 1000 이 쓰이는데, mj 계정이 1000 이 아니면 DB 생성이 실패합니다.
#
#   $ id -u
#   501
#   $ id -g
#   501
#
# → 아래에 501 을 넣으세요.
LIFEHUB_UID=1000
LIFEHUB_GID=1000

# ── 선택 ─────────────────────────────────────────────────────
APP_NAME=LifeHub 개인 관리

# 데모 데이터를 넣고 싶으면 1 (데모 계정이 없을 때만 주입)
#   데모 계정: demo@lifehub.app / demo1234
SEED_DEMO=0

# 날짜 계산이 UTC 기준이므로 UTC 유지 권장
TZ=UTC

# compose 프로젝트 이름 (cafe24 컨테이너와 분리). v1/v2 모두 지원
COMPOSE_PROJECT_NAME=lifehub
